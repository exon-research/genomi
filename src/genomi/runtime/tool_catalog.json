        "local_artifact_metadata",
        "local_workspace_file_metadata"
      ],
      "discovery_role": "entry_tool"
    },
    "genomi.start_portal_run": {
      "capability": "genomi",
      "namespace": "genomi",
      "description": "Start a GenomiLab host-agent run through the same project, frame, selected-evidence, and run-event contract used by the web UI.",
      "input_schema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "User-facing request to send into the portal conversation."
          },
          "project_id": {
            "type": "string",
            "description": "Optional portal project id. Omit to use or create the default portal project."
          },
          "frame_id": {
            "type": "string",
            "description": "Optional existing frame id for a follow-up message."
          },
          "source_frame_id": {
            "type": "string",
            "description": "Optional same-project frame id that supplied selected material for a new focused conversation. Ignored for follow-up messages."
          },
          "started_from_selected_material": {
            "type": "boolean",
            "description": "Set true when starting a new conversation from selected visible portal material so the new frame records a public started-from summary."
          },
          "agent_id": {
            "type": "string",
            "description": "Optional runnable host-agent id such as codex or claude. Omit to use the default available portal agent."
          },
          "selected_evidence": {
            "type": "array",
            "description": "Optional selected visual/context objects to attach to the portal prompt.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "skill": "SKILL.md",
      "area": "portal",
      "requires": [],
      "produces": [
        "portal_run_id",
        "portal_frame",
        "portal_run_status",
        "portal_run_events"
      ],
      "context_optional": [
        "portal_project_id",
        "portal_frame_id",
        "selected_visual_context"
      ],
      "privacy_scope": "local_private",
      "operation_scope": "write",
      "mcp_execution": "inline_only",
      "mutating": true,
      "external_io": [],
      "data_access": [
        "local_portal_project_state",
        "local_portal_transcript",
        "selected_visual_context",
        "host_agent_process"
      ],
      "discovery_role": "entry_tool"
    },
