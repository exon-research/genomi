  "operations": {
    "genomi.invoke": {
      "capability": "genomi",
      "namespace": "genomi",
      "description": "Dispatch a Genomi capability operation. Use this for any tool outside the genomi.* / journal.* / research.* namespaces. The agent must read the relevant capability skill (e.g. skills/pharmacogenomics/SKILL.md) for parameter shapes and result contracts before invoking. Returns the underlying tool's response unchanged.",
      "input_schema": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "description": "Qualified tool name in the form '<namespace>.<op>', e.g. 'pharmacogenomics.run_pharmcat' or 'clinvar.scan_candidates'. Must be a registered capability operation; tools already in default tools/list (genomi.*, journal.*, research.*) are not dispatchable through invoke."
          },
          "params": {
            "type": "object",
            "description": "Parameters for the named tool. Validated against the tool's own input_schema before dispatch.",
            "additionalProperties": true
          }
        },
        "required": [
          "tool",
          "params"
        ],
        "additionalProperties": false
      },
      "skill": "SKILL.md",
      "area": "runtime",
      "requires": [],
      "produces": [
        "dispatched_tool_result"
      ],
      "context_optional": [],
      "privacy_scope": "local_private",
      "operation_scope": "read",
      "mutating": false,
      "external_io": [],
      "data_access": [
        "local_artifact_metadata",
        "local_private_artifacts_when_supplied",
        "active_genome_index_when_selected",
        "public_catalog_metadata"
      ],
      "discovery_role": "entry_tool"
    },
    "genomi.install": {
      "capability": "genomi",
      "namespace": "genomi",
      "description": "Install or update Genomi. `genomi install` and `genomi update` are the same operation: they update the runtime code, reconcile host-agent skill symlinks, refresh retrieval indexes, reparse any stale genome, and install reference libraries — all of them by default, or the subset named in `libraries` (e.g. one library to add at runtime). For a first-time install on a machine without the genomi runtime, follow INSTALL_FOR_AGENTS.md instead.",
      "input_schema": {
        "type": "object",
        "properties": {
          "libraries": {
            "type": "string",
            "description": "Which reference libraries to materialize. Defaults to 'everything' (install all). Name a purpose or exact library IDs (e.g. common-questions, medication-response, clinvar-grch38) to install just that subset for on-demand single-library installs."
          },
          "response_profile": {
            "type": "string",
            "enum": [
              "eli5",
              "patient",
              "literate",
              "expert"
            ],
            "description": "Default explanation style to persist for downstream Genomi answers."
          },
          "force": {
            "$ref": "#/schema_fragments/properties/boolean_default_false"
          },
          "msigdb_gmt": {
            "$ref": "#/schema_fragments/properties/local_path"
          },
          "msigdb_gmt_url": {
            "type": "string"
          },
          "pharmcat_version": {
            "type": "string"
          },
          "ancestry_panel_url": {
            "type": "string"
          },
          "ancestry_panel_dir": {
            "$ref": "#/schema_fragments/properties/local_path"
          }
        },
        "additionalProperties": false
      },
      "skill": "INSTALL_FOR_AGENTS.md",
      "area": "resources",
      "produces": [
        "installed_libraries",
        "response_profile",
        "host_skill_links",
        "retrieval_index_refresh",
        "portal_onboarding"
      ],
      "context_optional": [
        "response_profile"
      ],
      "privacy_scope": "local_private",
      "operation_scope": "write",
      "mutating": true,
      "external_io": [
        "public_reference_downloads"
      ],
      "data_access": [
        "local_artifact_metadata",
        "public_catalog_metadata"
      ],
      "discovery_role": "entry_tool"
    },
    "genomi.check_background_job": {
      "capability": "genomi",
      "namespace": "genomi",
      "description": "Check a long-running MCP tool job and return its presented result when it has completed.",
      "input_schema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "job_path": {
            "$ref": "#/schema_fragments/properties/local_path"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "skill": "SKILL.md",
      "area": "runtime",
      "requires": [],
      "produces": [
        "background_job_status",
        "operation_result"
      ],
      "context_optional": [],
      "privacy_scope": "local_private",
      "operation_scope": "read",
      "mcp_execution": "inline_only",
      "mutating": false,
      "external_io": [],
      "data_access": [
        "background_job_result",
        "local_private_artifacts_when_job_targets_source",
        "active_genome_index_when_job_targets_agi"
      ],
      "discovery_role": "entry_tool"
    },
    "genomi.parse_source": {
      "capability": "genomi",
      "namespace": "genomi",
      "description": "Detect, parse, and digitize a genome source such as VCF/gVCF, BAM, paired FASTQ, supported consumer exports, or a genome.computer .genome/1.0 bundle. After parsing, read skills/active-genome-index/SKILL.md before using the invoke-only active_genome_index.* interpretation/selection tools; the result's next_actions repeats this.",
      "input_schema": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/schema_fragments/properties/local_path"
          },
          "source_evidence_db": {
            "$ref": "#/schema_fragments/properties/local_path"
          },
          "reference_fasta": {
            "$ref": "#/schema_fragments/properties/local_path"
          },
          "auto_reference_fasta": {
            "$ref": "#/schema_fragments/properties/boolean_default_true"
          },
          "genome_build": {
            "type": "string",
            "default": "auto"
          },
          "max_records": {
            "type": "integer"
          },
          "parallel_workers": {
            "type": "integer"
          },
          "force": {
            "$ref": "#/schema_fragments/properties/force"
          },
          "user_nickname": {
            "type": "string"
          },
          "set_default_user": {
            "$ref": "#/schema_fragments/properties/boolean_default_false"
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false,
        "x_genomi_property_groups": [
          "storage_db_pair"
        ]
      },
      "skill": "skills/active-genome-index/SKILL.md",
      "area": "context",
      "requires": [
        "genome_source_file"
      ],
      "produces": [
        "active_genome_index",
        "genome_index",
        "evidence_db",
        "active_genome_index_access"
      ],
      "context_optional": [
        "user_nickname"
      ],
      "privacy_scope": "local_private",
      "operation_scope": "write",
      "mutating": true,
      "external_io": [],
      "data_access": [
        "genome_source_file",
        "active_genome_index_created_or_updated"
      ],
      "discovery_role": "entry_tool"
    },
    "genomi.describe_context": {
      "capability": "genomi",
      "namespace": "genomi",
      "description": "Return the current personal/session context: Active Genome Index access state, current user, and active_response_profile (the user's selected tone). Use when the user asks about their genome/context, a previous run, or before sample-specific claims. Public-only context (no active genome) is a valid state — don't require this for public-only questions.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "skill": "SKILL.md",
      "area": "context",
      "requires": [],
      "produces": [
        "context_status",
        "active_genome_index",
        "user_registry_metadata"
      ],
      "context_optional": [],
      "privacy_scope": "metadata_only",
      "operation_scope": "read",
      "mutating": false,
      "external_io": [],
      "data_access": [
        "local_artifact_metadata",
        "public_catalog_metadata"
      ],
      "discovery_role": "entry_tool"
    },
