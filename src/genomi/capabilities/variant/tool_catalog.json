{
  "capabilities": {
    "variant-evidence": {
      "title": "Variant and Public Evidence",
      "start_when": "The question names an rsID, variant, gene, condition, or source-backed public claim.",
      "skill_documents": [
        "skills/variant-evidence/SKILL.md"
      ],
      "entry_operations": [
        "variant.resolve"
      ],
      "operations": [
        "variant.gather_gene_context",
        "variant.gather_allele_context",
        "variant.find_gene_variants",
        "variant.resolve"
      ]
    }
  },
  "operations": {
    "variant.find_gene_variants": {
      "capability": "variant-evidence",
      "namespace": "variant",
      "description": "Find passing variants in an approved Active Genome Index that overlap managed GENCODE intervals for a bounded candidate-gene set.",
      "input_schema": {
        "type": "object",
        "properties": {
          "genes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "genome_build": {
            "type": "string",
            "default": "GRCh38",
            "enum": [
              "GRCh37",
              "GRCh38"
            ],
            "x_genomi_default": {
              "source": "tool_default",
              "condition": "If an approved Active Genome Index supplies genome_build, that context value is used before this fallback."
            }
          },
          "agi_id": {
            "type": "string"
          },
          "per_gene_limit": {
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "genes"
        ],
        "additionalProperties": false
      },
      "skill": "skills/variant-evidence/SKILL.md",
      "area": "variant",
      "requires": [
        "bounded_candidate_genes",
        "approved_active_genome_index",
        "variant_callset_or_sequencing_active_genome_index",
        "matching_build_gencode_annotation"
      ],
      "produces": [
        "gene_coordinate_resolution",
        "active_genome_index_gene_interval_variants",
        "coverage",
        "evidence_envelope"
      ],
      "context_optional": [
        "agi_id",
        "genome_build"
      ],
      "privacy_scope": "local_private",
      "operation_scope": "read",
      "mutating": false,
      "external_io": [
        "local_gencode_gtf"
      ],
      "data_access": [
        "active_genome_index",
        "installed_gencode_gene_coordinates"
      ],
      "optional_libraries": [
        "gencode-grch38",
        "gencode-grch37"
      ],
      "library_check_operation": "genomi.check_libraries",
      "discovery_role": "focused_tool"
    },
    "variant.resolve": {
      "capability": "variant-evidence",
      "namespace": "variant",
      "description": "Resolve one variant target and return deterministic public, local sample, and stored evidence facts.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "rsid": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "genome_build": {
            "type": "string",
            "default": "GRCh38"
          },
          "agi_id": {
            "type": "string"
          },
          "include_active_genome_index": {
            "type": "boolean",
            "x_genomi_default": {
              "rule": "true only when scoped Active Genome Index access is approved and no agi_id is supplied; otherwise false",
              "source": "contextual_default",
              "possible_values": [
                false,
                true
              ]
            }
          },
          "include_known_active_genome_indexes": {
            "$ref": "#/schema_fragments/properties/include_known_active_genome_indexes"
          },
          "include_fail": {
            "$ref": "#/schema_fragments/properties/include_fail"
          },
          "limit": {
            "$ref": "#/schema_fragments/properties/limit_20"
          }
        },
        "required": [],
        "additionalProperties": false,
        "x_genomi_property_groups": [
          "storage_db_pair",
          "variant_locus"
        ]
      },
      "skill": "skills/variant-evidence/SKILL.md",
      "area": "variant",
      "requires": [],
      "produces": [
        "variant_lookup_packet",
        "resolved_variant_targets",
        "sample_presence_context",
        "public_variant_context",
        "variant_unanswered_answer_components",
        "variant_target_inventory"
      ],
      "context_optional": [
        "db",
        "shared_db",
        "agi_id",
        "active_genome_index"
      ],
      "privacy_scope": "target_scoped",
      "operation_scope": "read",
      "mutating": false,
      "external_io": [],
      "data_access": [
        "selected_public_targets",
        "active_genome_index_when_selected",
        "explicit_known_active_genome_indexes_when_selected"
      ],
      "discovery_role": "entry_tool"
    },
    "variant.gather_allele_context": {
      "capability": "variant-evidence",
      "namespace": "variant",
      "description": "Gather existing sample, static, population, and reviewed research evidence for one allele.",
      "input_schema": {
        "type": "object",
        "properties": {
          "db": {
            "$ref": "#/schema_fragments/properties/local_path"
          },
          "matches": {
            "$ref": "#/schema_fragments/properties/local_path"
          },
          "genome_build": {
            "$ref": "#/schema_fragments/properties/genome_build_grch38_contextual"
          },
          "population_source": {
            "type": "string"
          },
          "population": {
            "type": "string"
          }
        },
        "required": [
          "chrom",
          "pos",
          "ref",
          "alt"
        ],
        "additionalProperties": false,
        "x_genomi_property_groups": [
          "variant_locus"
        ]
      },
      "skill": "skills/variant-evidence/SKILL.md",
      "area": "variant",
      "requires": [
        "allele"
      ],
      "produces": [
        "allele_context"
      ],
      "context_optional": [
        "db",
        "matches",
        "genome_build"
      ],
      "privacy_scope": "local_private",
      "operation_scope": "read",
      "mutating": false,
      "external_io": [],
      "data_access": [
        "local_private_evidence_files"
      ],
      "discovery_role": "focused_tool"
    },
    "variant.gather_gene_context": {
      "capability": "variant-evidence",
      "namespace": "variant",
      "description": "Gather existing sample, ClinVar, and reviewed research evidence for one gene.",
      "input_schema": {
        "type": "object",
        "properties": {
          "db": {
            "$ref": "#/schema_fragments/properties/local_path"
          },
          "gene": {
            "type": "string"
          },
          "matches": {
            "$ref": "#/schema_fragments/properties/local_path"
          },
          "genome_build": {
            "$ref": "#/schema_fragments/properties/genome_build_grch38_contextual"
          }
        },
        "required": [
          "gene"
        ],
        "additionalProperties": false
      },
      "skill": "skills/variant-evidence/SKILL.md",
      "area": "variant",
      "requires": [
        "gene"
      ],
      "produces": [
        "gene_context"
      ],
      "context_optional": [
        "db",
        "matches",
        "genome_build"
      ],
      "privacy_scope": "local_private",
      "operation_scope": "read",
      "mutating": false,
      "external_io": [],
      "data_access": [
        "local_private_evidence_files"
      ],
      "discovery_role": "focused_tool"
    }
  }
}
